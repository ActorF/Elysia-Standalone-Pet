{
  "name": "elysia_desktop_pet",
  "productName": "爱莉希雅桌宠",
  "version": "1.0.0",
  "private": true,
  "description": "独立爱莉希雅桌面伙伴",
  "author": "ActorF",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/launch.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "package": "electron-builder --dir",
    "make:portable": "electron-builder --win portable",
    "test:smoke": "node scripts/launch.cjs --smoke-test",
    "test:visual": "node scripts/visual-check.cjs",
    "test:faces": "node scripts/face-integrity-check.cjs",
    "preview:expressions": "node scripts/gallery-preview.cjs",
    "preview:motion": "node scripts/gallery-preview.cjs --motion",
    "test:zoom": "node scripts/tray-zoom-check.cjs"
  },
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "io.actorf.elysia.standalonepet",
    "productName": "爱莉希雅桌宠",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/character/*.png",
      "package.json",
      "LICENSE",
      "ASSET-NOTICE.md"
    ],
    "asarUnpack": [
      "electron/legacy-hotkeys.ps1"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Elysia_desktop_pet-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ActorF/Elysia_desktop_pet.git"
  },
  "homepage": "https://github.com/ActorF/Elysia_desktop_pet#readme",
  "bugs": {
    "url": "https://github.com/ActorF/Elysia_desktop_pet/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
